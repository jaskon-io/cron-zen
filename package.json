{
  "name": "cron-zen",
  "version": "0.1.0",
  "private": true,
  "description": "Embeddable Quartz/cron.ren Cron engine — @cron-zen/core (any runtime) + @cron-zen/vue3 (Vue 3, no Element required)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaskon-io/cron-zen.git"
  },
  "homepage": "https://jaskon-io.github.io/cron-zen/",
  "bugs": {
    "url": "https://github.com/jaskon-io/cron-zen/issues"
  },
  "keywords": [
    "cron",
    "cron-expression",
    "quartz",
    "vue",
    "vue3",
    "scheduler",
    "cron-zen"
  ],
  "scripts": {
    "dev": "pnpm --filter @cron-zen/playground dev",
    "docs:dev": "pnpm --filter @cron-zen/docs dev",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:preview": "pnpm --filter @cron-zen/docs preview --base /cron-zen/",
    "build": "pnpm -r --filter @cron-zen/core build && pnpm -r --filter @cron-zen/vue3 build && pnpm -r --filter @cron-zen/vue2 build",
    "build:core": "pnpm --filter @cron-zen/core build",
    "build:vue3": "pnpm --filter @cron-zen/vue3 build",
    "build:vue2": "pnpm --filter @cron-zen/vue2 build",
    "test": "pnpm -r --filter @cron-zen/core test && pnpm -r --filter @cron-zen/vue3 test",
    "test:coverage": "pnpm -r --filter @cron-zen/core test:coverage",
    "typecheck": "pnpm -r --filter @cron-zen/core typecheck && pnpm -r --filter @cron-zen/vue3 typecheck && pnpm -r --filter @cron-zen/vue2 typecheck"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@10.14.0"
}
