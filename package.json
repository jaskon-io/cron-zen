{
  "name": "cron-zen",
  "version": "0.1.0",
  "private": true,
  "description": "Visual Cron expression generator for Vue 2 / Vue 3",
  "license": "MIT",
  "keywords": [
    "cron",
    "cron-expression",
    "quartz",
    "vue",
    "vue3",
    "scheduler",
    "cron-zen"
  ],
  "scripts": {
    "build": "pnpm -r --filter @cron-zen/core build && pnpm -r --filter @cron-zen/vue3 build",
    "build:core": "pnpm --filter @cron-zen/core build",
    "build:vue3": "pnpm --filter @cron-zen/vue3 build",
    "test": "pnpm -r --filter @cron-zen/core test",
    "test:coverage": "pnpm -r --filter @cron-zen/core test:coverage",
    "typecheck": "pnpm -r --filter @cron-zen/core typecheck && pnpm -r --filter @cron-zen/vue3 typecheck"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@10.14.0"
}
