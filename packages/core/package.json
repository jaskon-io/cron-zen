{
  "name": "@cron-zen/core",
  "version": "0.2.4",
  "description": "Framework-agnostic Quartz/cron.ren Cron parser, generator, validator, describe, and next-run estimates",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaskon-io/cron-zen.git",
    "directory": "packages/core"
  },
  "homepage": "https://jaskon-io.github.io/cron-zen/api/core",
  "bugs": {
    "url": "https://github.com/jaskon-io/cron-zen/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "cron",
    "cron-expression",
    "quartz",
    "parser",
    "scheduler",
    "cron-zen"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
