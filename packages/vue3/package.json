{
  "name": "@cron-zen/vue3",
  "version": "0.2.4",
  "description": "Vue 3 Cron visual editor for cron-zen — CronZen / useCronZen, no Element or Ant required",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaskon-io/cron-zen.git",
    "directory": "packages/vue3"
  },
  "homepage": "https://jaskon-io.github.io/cron-zen/api/vue3",
  "bugs": {
    "url": "https://github.com/jaskon-io/cron-zen/issues"
  },
  "type": "module",
  "main": "./dist/cron-zen-vue3.umd.cjs",
  "module": "./dist/cron-zen-vue3.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/cron-zen-vue3.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/cron-zen-vue3.js",
      "require": "./dist/cron-zen-vue3.umd.cjs"
    },
    "./style.css": "./dist/cron-zen-vue3.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "cron",
    "vue",
    "vue3",
    "cron-expression",
    "cron-zen"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly -p tsconfig.json --outDir dist",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "peerDependencies": {
    "vue": "^3.2.0",
    "element-plus": "^2.4.0"
  },
  "peerDependenciesMeta": {
    "element-plus": {
      "optional": true
    }
  },
  "dependencies": {
    "@cron-zen/core": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "element-plus": "^2.9.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
